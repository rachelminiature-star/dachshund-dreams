{
  "$schema": "node_modules/wrangler/config-schema.json",

  "name": "dachshund-dreams",

  "main": "./dist/server/server.js",

  "compatibility_date": "2026-06-19",

  "compatibility_flags": [
    "nodejs_compat"
  ],

  "assets": {
    "directory": "./dist/client",
    "binding": "ASSETS"
  },

  "observability": {
    "enabled": true
  },

  "vars": {
    "NODE_ENV": "production"
  }
}
